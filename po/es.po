msgstr "{prog}: falta el argumento de {opt}\n"

#: src/npcli/args.py:226 src/npcli/args.py:236
#, python-brace-format
msgid "{prog}: invalid number: {text}\n"
msgstr "{prog}: número no válido: {text}\n"

#: src/npcli/args.py:228
#, python-brace-format
msgid "{prog}: port out of range\n"
msgstr "{prog}: puerto fuera de rango\n"

#: src/npcli/args.py:239
#, python-brace-format
msgid "{prog}: lambda must be positive\n"
msgstr "{prog}: lambda debe ser positivo\n"

#: src/npcli/args.py:240
#, python-brace-format
msgid "{prog}: duration must be positive\n"
msgstr "{prog}: la duración debe ser positiva\n"

#: src/npcli/args.py:247
#, python-brace-format
msgid "{prog}: unknown profile {name}\n"
msgstr "{prog}: perfil desconocido {name}\n"

#: src/npcli/args.py:331 src/npcli/args.py:339
#, python-brace-format
msgid "{prog}: unknown option {opt}\n"
msgstr "{prog}: opción desconocida {opt}\n"

#: src/npcli/args.py:403
#, python-brace-format
msgid "{prog}: unexpected argument {text}\n"
msgstr "{prog}: argumento inesperado {text}\n"

#: src/npcli/args.py:409
#, python-brace-format
msgid "{prog}: do not combine --daemon with SERVER\n"
msgstr "{prog}: no combine --daemon con SERVIDOR\n"

#: src/npcli/args.py:411
#, python-brace-format
msgid "{prog}: --stdio-server is exclusive\n"
msgstr "{prog}: --stdio-server es exclusivo\n"

#: src/npcli/args.py:413
#, python-brace-format
msgid "{prog}: --udp cannot combine with --ssh\n"
msgstr "{prog}: --udp no se puede combinar con --ssh\n"

#: src/npcli/args.py:415
#, python-brace-format
msgid "{prog}: UDP --tls requires --psk\n"
msgstr "{prog}: UDP --tls requiere --psk\n"

#: src/npcli/args.py:417
#, python-brace-format
msgid "{prog}: --cert and --key must be used together\n"
msgstr "{prog}: --cert y --key deben usarse juntos\n"

#: src/npcli/args.py:419
#, python-brace-format
msgid "{prog}: choose --install or --remove\n"
msgstr "{prog}: elija --install o --remove\n"

#: src/npcli/args.py:427 src/npcli/args.py:434
#, python-brace-format
msgid "{prog}: invalid server address\n"
msgstr "{prog}: dirección de servidor no válida\n"

#: src/npcli/main.py:93
#, python-brace-format
msgid "{prog}: wrote {path}"
msgstr "{prog}: escrito {path}"

#: src/npcli/main.py:94
#, python-brace-format
msgid "{prog}: run: systemctl --user daemon-reload && systemctl --user enable --now netpoisson"
msgstr "{prog}: ejecute: systemctl --user daemon-reload && systemctl --user enable --now netpoisson"

#: src/npcli/main.py:102
#, python-brace-format
msgid "{prog}: removed {path}"
msgstr "{prog}: eliminado {path}"

#: src/npcli/main.py:104
#, python-brace-format
msgid "{prog}: no unit at {path}"
msgstr "{prog}: no hay unidad en {path}"

#: src/npcli/main.py:139 src/npcli/main.py:152
#, python-brace-format
msgid "{prog}: {message}\n"
msgstr "{prog}: {message}\n"

#: src/npcli/main.py:154
#, python-brace-format
msgid "{prog}: dashboard {url}"
msgstr "{prog}: tablero {url}"

#: src/npcli/main.py:225
#, python-brace-format
msgid "{prog}: --lambda applies to the client; ignoring it"
msgstr "{prog}: --lambda es del cliente; se ignora"

#: src/npcli/main.py:242 src/npcli/main.py:325
#, python-brace-format
msgid "{prog}: {message}"
msgstr "{prog}: {message}"

#: src/npcli/main.py:249
#, python-brace-format
msgid "{prog}: listening on {proto}://{endpoint}"
msgstr "{prog}: escuchando en {proto}://{endpoint}"

#: src/npcli/main.py:291
#, python-brace-format
msgid "{prog}: --host is the listen address; the target is SERVER"
msgstr "{prog}: --host es la dirección de escucha; el destino es SERVIDOR"

#: src/npcli/main.py:330
#, python-brace-format
msgid "{prog}: connected {proto} {endpoint} at {lam} req/s"
msgstr "{prog}: conectado a {proto} {endpoint} a {lam} pet./s"

#~ msgid ""
#~ "Offer a Poisson stream of requests to SERVER, or listen for them when\n"
#~ "SERVER is omitted.\n"
#~ msgstr "Envía un flujo de Poisson de peticiones a SERVIDOR, o escucha si se omite.\n"

#~ msgid "  -d, --daemon       listen (also the default when SERVER is omitted)\n"
#~ msgstr "  -d, --daemon       escuchar (también por defecto si se omite SERVIDOR)\n"

#~ msgid "  -H, --host HOST    address to bind (default 0.0.0.0)\n"
#~ msgstr "  -H, --host HOST    dirección de enlace (predeterminado 0.0.0.0)\n"

#~ msgid "  -p, --port PORT    port to bind or connect to (default 1871)\n"
#~ msgstr "  -p, --port PORT    puerto de enlace o conexión (predeterminado 1871)\n"

#~ msgid "  -u, --udp          use UDP (default is TCP)\n"
#~ msgstr "  -u, --udp          usar UDP (el predeterminado es TCP)\n"

#~ msgid "  -l, --lambda N     offered requests per second (default 100)\n"
#~ msgstr "  -l, --lambda N     peticiones ofrecidas por segundo (predeterminado 100)\n"

#~ msgid "  -s, --stats SECS   run for SECS seconds, then print a JSON report\n"
#~ msgstr "  -s, --stats SECS   ejecutar SECS segundos y luego imprimir un informe JSON\n"

#~ msgid "  -w, --web          serve a live dashboard and open a browser\n"
#~ msgstr "  -w, --web          servir un tablero en vivo y abrir un navegador\n"

#~ msgid "      --web-host H   dashboard address (default 127.0.0.1)\n"
#~ msgstr "      --web-host H   dirección del tablero (predeterminado 127.0.0.1)\n"

#~ msgid "      --web-port N   dashboard port (default 8711)\n"
#~ msgstr "      --web-port N   puerto del tablero (predeterminado 8711)\n"

#~ msgid ""
#~ "ECHO responses are the request bytes. STATUS responses carry the server\n"
#~ "timeline and queues. Req/Resp lines scroll right: newest slices on the left.\n"
#~ msgstr ""
#~ "Las respuestas ECHO son los bytes de la petición. STATUS lleva la línea de tiempo y las colas.\n"
#~ "Req/Resp se desplazan a la derecha: lo más nuevo queda a la izquierda.\n"

#~ msgid "Req counts local arrivals per slice (newest on the left). The center number has not left this host."
#~ msgstr "Req cuenta las llegadas locales por intervalo (lo más nuevo a la izquierda). El número central aún no ha salido de este equipo."

#~ msgid "Resp counts server replies per slice. Left of the arrow: requests not yet read. Next: replies not yet sent."
#~ msgstr "Resp cuenta las respuestas del servidor por intervalo. A la izquierda de la flecha: peticiones aún no leídas. Después: respuestas aún no enviadas."
