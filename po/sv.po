#~ msgid ""
#~ "Offer a Poisson stream of requests to SERVER, or listen for them when\n"
#~ "SERVER is omitted.\n"
#~ msgstr ""
#~ "Skicka en Poisson-ström av förfrågningar till SERVER, eller lyssna om "
#~ "SERVER utelämnas.\n"

#~ msgid ""
#~ "  -d, --daemon       listen (also the default when SERVER is omitted)\n"
#~ msgstr "  -d, --daemon       lyssna (även standard om SERVER utelämnas)\n"

#~ msgid "  -H, --host HOST    address to bind (default 0.0.0.0)\n"
#~ msgstr "  -H, --host HOST    adress att binda (standard 0.0.0.0)\n"

#~ msgid "  -p, --port PORT    port to bind or connect to (default 1871)\n"
#~ msgstr ""
#~ "  -p, --port PORT    port att binda eller ansluta till (standard 1871)\n"

#~ msgid "  -u, --udp          use UDP (default is TCP)\n"
#~ msgstr "  -u, --udp          använd UDP (standard är TCP)\n"

#~ msgid "  -l, --lambda N     offered requests per second (default 100)\n"
#~ msgstr ""
#~ "  -l, --lambda N     erbjudna förfrågningar per sekund (standard 100)\n"

#~ msgid ""
#~ "  -s, --stats SECS   run for SECS seconds, then print a JSON report\n"
#~ msgstr ""
#~ "  -s, --stats SECS   kör i SECS sekunder och skriv sedan en JSON-rapport\n"

#~ msgid "  -w, --web          serve a live dashboard and open a browser\n"
#~ msgstr "  -w, --web          serva en livepanel och öppna en webbläsare\n"

#~ msgid "      --web-host H   dashboard address (default 127.0.0.1)\n"
#~ msgstr "      --web-host H   panelens adress (standard 127.0.0.1)\n"

#~ msgid "      --web-port N   dashboard port (default 8711)\n"
#~ msgstr "      --web-port N   panelens port (standard 8711)\n"

#~ msgid ""
#~ "ECHO responses are the request bytes. STATUS responses carry the server\n"
#~ "timeline and queues. Req/Resp lines scroll right: newest slices on the "
#~ "left.\n"
#~ msgstr ""
#~ "ECHO-svar är förfrågans byte. STATUS bär serverns tidslinje och köer.\n"
#~ "Req/Resp rullar åt höger: nyaste intervallen står till vänster.\n"

#~ msgid ""
#~ "Req counts local arrivals per slice (newest on the left). The center "
#~ "number has not left this host."
#~ msgstr ""
#~ "Req räknar lokala ankomster per intervall (nyast till vänster). Talet i "
#~ "mitten har inte lämnat den här värden."

#~ msgid ""
#~ "Resp counts server replies per slice. Left of the arrow: requests not yet "
#~ "read. Next: replies not yet sent."
#~ msgstr ""
#~ "Resp räknar serverns svar per intervall. Vänster om pilen: förfrågningar "
#~ "som inte lästs. Nästa: svar som inte skickats."
