msgstr "{prog}: escreveu {path}"

#: src/npcli/main.py:94
#, python-brace-format
msgid ""
"{prog}: run: systemctl --user daemon-reload && systemctl --user enable --now "
"netpoisson"
msgstr "{prog}: execute: systemctl --user daemon-reload && systemctl --user enable --now netpoisson"

#: src/npcli/main.py:102
#, python-brace-format
msgid "{prog}: removed {path}"
msgstr "{prog}: removeu {path}"

#: src/npcli/main.py:104
#, python-brace-format
