#, python-brace-format
msgid "{prog}: {message}\n"
msgstr "{prog}: {message}\n"

#: src/npcli/main.py:154
#, python-brace-format
msgid "{prog}: dashboard {url}"
msgstr "{prog}: painel {url}"

#: src/npcli/main.py:225
#, python-brace-format
msgid "{prog}: --lambda applies to the client; ignoring it"
msgstr "{prog}: --lambda aplica-se ao cliente; a ignorar"

#: src/npcli/main.py:242 src/npcli/main.py:325
#, python-brace-format
msgid "{prog}: {message}"
msgstr "{prog}: {message}"

#: src/npcli/main.py:249
#, python-brace-format
msgid "{prog}: listening on {proto}://{endpoint}"
msgstr "{prog}: a escutar em {proto}://{endpoint}"

#: src/npcli/main.py:291
#, python-brace-format
msgid "{prog}: --host is the listen address; the target is SERVER"
msgstr "{prog}: --host é o endereço de escuta; o alvo é SERVIDOR"

#: src/npcli/main.py:330
#, python-brace-format
msgid "{prog}: connected {proto} {endpoint} at {lam} req/s"
msgstr "{prog}: ligado a {proto} {endpoint} a {lam} ped./s"

#~ msgid ""
#~ "Offer a Poisson stream of requests to SERVER, or listen for them when\n"
#~ "SERVER is omitted.\n"
#~ msgstr ""
#~ "Envia um fluxo de Poisson de pedidos a SERVIDOR, ou escuta se SERVIDOR "
#~ "for omitido.\n"

#~ msgid ""
#~ "  -d, --daemon       listen (also the default when SERVER is omitted)\n"
#~ msgstr ""
#~ "  -d, --daemon       escutar (também a omissão quando SERVIDOR falta)\n"

#~ msgid "  -H, --host HOST    address to bind (default 0.0.0.0)\n"
#~ msgstr "  -H, --host HOST    endereço de escuta (omissão 0.0.0.0)\n"

#~ msgid "  -p, --port PORT    port to bind or connect to (default 1871)\n"
#~ msgstr "  -p, --port PORT    porta de escuta ou ligação (omissão 1871)\n"

#~ msgid "  -u, --udp          use UDP (default is TCP)\n"
#~ msgstr "  -u, --udp          usar UDP (a omissão é TCP)\n"

#~ msgid "  -l, --lambda N     offered requests per second (default 100)\n"
#~ msgstr "  -l, --lambda N     pedidos oferecidos por segundo (omissão 100)\n"

#~ msgid ""
#~ "  -s, --stats SECS   run for SECS seconds, then print a JSON report\n"
#~ msgstr ""
#~ "  -s, --stats SECS   correr SECS segundos e depois imprimir um relatório "
#~ "JSON\n"

#~ msgid "  -w, --web          serve a live dashboard and open a browser\n"
#~ msgstr ""
#~ "  -w, --web          servir um painel ao vivo e abrir um navegador\n"

#~ msgid "      --web-host H   dashboard address (default 127.0.0.1)\n"
#~ msgstr "      --web-host H   endereço do painel (omissão 127.0.0.1)\n"

#~ msgid "      --web-port N   dashboard port (default 8711)\n"
#~ msgstr "      --web-port N   porta do painel (omissão 8711)\n"

#~ msgid ""
#~ "ECHO responses are the request bytes. STATUS responses carry the server\n"
#~ "timeline and queues. Req/Resp lines scroll right: newest slices on the "
#~ "left.\n"
#~ msgstr ""
#~ "As respostas ECHO são os bytes do pedido. STATUS traz a linha temporal e "
#~ "as filas.\n"
#~ "Req/Resp deslocam-se para a direita: as fatias novas ficam à esquerda.\n"

#~ msgid ""
#~ "Req counts local arrivals per slice (newest on the left). The center "
#~ "number has not left this host."
#~ msgstr ""
#~ "Req conta as chegadas locais por fatia (as mais recentes à esquerda). O "
#~ "número ao centro ainda não saiu deste anfitrião."

#~ msgid ""
#~ "Resp counts server replies per slice. Left of the arrow: requests not yet "
#~ "read. Next: replies not yet sent."
#~ msgstr ""
#~ "Resp conta as respostas do servidor por fatia. À esquerda da seta: "
#~ "pedidos ainda não lidos. A seguir: respostas ainda não enviadas."
