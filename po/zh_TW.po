#: src/npcli/args.py:109
msgid "Usage: netpoisson [OPTION]... [SERVER]\n"
msgstr "用法：netpoisson [選項]... [伺服器]\n"

#: src/npcli/args.py:112
msgid ""
"Offer a Poisson stream of requests to SERVER, or listen when SERVER is "
"omitted.\n"
msgstr "依泊松過程向伺服器發送請求；若省略伺服器，則改為監聽。\n"

#: src/npcli/args.py:116
msgid "Modes:\n"
msgstr "模式：\n"

#: src/npcli/args.py:117
msgid ""
"  -d, --daemon              listen (also the default when SERVER is "
"omitted)\n"
msgstr "  -d, --daemon              監聽（省略伺服器時也是預設行為）\n"

#: src/npcli/args.py:118
msgid ""
"      --stdio-server        serve NDJSON @nPoi protocol on stdin/stdout\n"
msgstr "      --stdio-server        在 stdin/stdout 上提供 NDJSON @nPoi 協定\n"

#: src/npcli/args.py:119
msgid "      --ssh TARGET          run client over SSH stdio to TARGET\n"
msgstr "      --ssh TARGET          透過 SSH stdio 在 TARGET 上執行用戶端\n"

#: src/npcli/args.py:120
msgid "      --install/--remove    manage a systemd user service unit\n"
msgstr "      --install/--remove    管理 systemd 使用者服務單元\n"

#: src/npcli/args.py:122
msgid "Transport:\n"
msgstr "傳輸：\n"

#: src/npcli/args.py:123
msgid "  -H, --host HOST           bind host (default 0.0.0.0)\n"
msgstr "  -H, --host HOST           繫結主機（預設 0.0.0.0）\n"

#: src/npcli/args.py:124
msgid "  -p, --port PORT           port (default 1871)\n"
msgstr "  -p, --port PORT           埠號（預設 1871）\n"

#: src/npcli/args.py:125
msgid "  -u, --udp                 UDP; default TCP\n"
msgstr "  -u, --udp                 UDP；預設 TCP\n"

#: src/npcli/args.py:126
msgid "      --tls                 TLS on TCP; PSK seal on UDP (needs --psk)\n"
msgstr "      --tls                 TCP 用 TLS；UDP 用 PSK 密封（需 --psk）\n"

#: src/npcli/args.py:127
msgid "      --psk TEXT            pre-shared key for UDP seal\n"
msgstr "      --psk TEXT            UDP 密封用的預先共用金鑰\n"

#: src/npcli/args.py:128
msgid "      --cert/--key PATH     TLS server certificate and key (PEM)\n"
msgstr "      --cert/--key PATH     TLS 伺服器憑證與金鑰（PEM）\n"

#: src/npcli/args.py:129
msgid "      --tls-ca PATH         TLS client CA file\n"
msgstr "      --tls-ca PATH         TLS 用戶端 CA 檔\n"

#: src/npcli/args.py:130
msgid "      --tls-insecure        TLS client: skip certificate verify\n"
msgstr "      --tls-insecure        TLS 用戶端：略過憑證驗證\n"

#: src/npcli/args.py:131
msgid "      --ssh-command PATH    ssh binary (default ssh)\n"
msgstr "      --ssh-command PATH    ssh 可執行檔（預設 ssh）\n"

#: src/npcli/args.py:132
msgid "      --remote-command CMD  remote stdio server command\n"
msgstr "      --remote-command CMD  遠端 stdio 伺服器命令\n"

#: src/npcli/args.py:133
msgid "      --ssh-option KEY=VAL  extra -o option (repeatable)\n"
msgstr "      --ssh-option KEY=VAL  額外的 -o 選項（可重複）\n"

#: src/npcli/args.py:135
msgid "Traffic:\n"
msgstr "流量：\n"

#: src/npcli/args.py:136
msgid "  -l, --lambda RATE         mean requests/s (default 100)\n"
msgstr "  -l, --lambda RATE         平均請求/秒（預設 100）\n"

#: src/npcli/args.py:137
msgid "      --payload SIZE        payload size (default 64B)\n"
msgstr "      --payload SIZE        酬載大小（預設 64B）\n"

#: src/npcli/args.py:138
msgid "      --connections N       parallel TCP connections (default 1)\n"
msgstr "      --connections N       平行 TCP 連線數（預設 1）\n"

#: src/npcli/args.py:139
msgid "      --max-pending N       client pending queue limit\n"
msgstr "      --max-pending N       用戶端待處理佇列上限\n"

#: src/npcli/args.py:140
msgid "      --status-interval D   STATUS interval (default 100ms)\n"
msgstr "      --status-interval D   STATUS 間隔（預設 100ms）\n"

#: src/npcli/args.py:141
msgid "      --bucket D            timeline bucket (default 100ms)\n"
msgstr "      --bucket D            時間軸分桶（預設 100ms）\n"

#: src/npcli/args.py:142
msgid ""
"      --window D            visible window (default auto; or e.g. 12s)\n"
msgstr "      --window D            可見視窗（預設 auto；或如 12s）\n"

#: src/npcli/args.py:143
msgid "      --seed N              reproducible RNG seed\n"
msgstr "      --seed N              可重現的亂數種子\n"

#: src/npcli/args.py:144
msgid "      --profile NAME        ssh-interactive | ssh-bulk\n"
msgstr "      --profile NAME        ssh-interactive | ssh-bulk\n"

#: src/npcli/args.py:146
msgid "Execution:\n"
msgstr "執行：\n"

#: src/npcli/args.py:147
msgid "  -s, --stats D             run for D then print a final report\n"
msgstr "  -s, --stats D             執行 D 後列印最終報告\n"

#: src/npcli/args.py:148
msgid "  -w, --web[=ADDR]          start Web UI (default 127.0.0.1:3871)\n"
msgstr "  -w, --web[=ADDR]          啟動 Web 介面（預設 127.0.0.1:3871）\n"

#: src/npcli/args.py:149
msgid "      --no-open             do not open a browser\n"
msgstr "      --no-open             不開啟瀏覽器\n"

#: src/npcli/args.py:150
msgid "      --json                force NDJSON event output\n"
msgstr "      --json                強制輸出 NDJSON 事件\n"

#: src/npcli/args.py:151
msgid "      --report FILE         save final JSON report\n"
msgstr "      --report FILE         儲存最終 JSON 報告\n"

#: src/npcli/args.py:153
msgid "repeat for more verbose loggings\n"
msgstr "重複使用以輸出更多詳細日誌\n"

#: src/npcli/args.py:155
msgid "show less logging messages\n"
msgstr "顯示較少的日誌訊息\n"

#: src/npcli/args.py:157
msgid "display this help and exit\n"
msgstr "顯示此說明並離開\n"

#: src/npcli/args.py:159
msgid "output version information and exit\n"
msgstr "輸出版本資訊並離開\n"

#: src/npcli/args.py:163
msgid ""
"TCP/UDP use a length-prefixed binary PDU. SSH stdio uses @nPoi NDJSON "
"lines.\n"
"When stdout is not a TTY, live UI is suppressed and NDJSON events are "
"emitted.\n"
msgstr "TCP/UDP 使用帶長度前綴的二進位 PDU。SSH stdio 使用 @nPoi 的 NDJSON 行。\n當 stdout 不是 TTY 時，不顯示即時介面，改為輸出 NDJSON 事件。\n"

#: src/npcli/args.py:168
#, python-brace-format
msgid "Report bugs to: <{email}>\n"
msgstr "回報問題至：<{email}>\n"

#: src/npcli/args.py:173
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "著作權所有 (C) {year} {author}\n"

#: src/npcli/args.py:174
msgid ""
"License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr ""
"授權條款 AGPL-3.0-or-later：<https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/npcli/args.py:175
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "這是自由軟體：你可以自由修改並重新散布。\n"

#: src/npcli/args.py:176
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "本專案反對 AI 剝削與 AI 霸權。\n"

#: src/npcli/args.py:179
msgid ""
"This project rejects mindless MIT-style licensing and politically naive BSD-"
"style licensing.\n"
msgstr "本專案反對無腦 MIT 式授權和政治愚蠢的 BSD 式授權。\n"

#: src/npcli/args.py:183
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "在法律允許的範圍內，不提供任何擔保。\n"

#: src/npcli/args.py:218
#, python-brace-format
msgid "{prog}: missing argument for {opt}\n"
msgstr "{prog}：缺少 {opt} 的參數\n"

#: src/npcli/args.py:226 src/npcli/args.py:236
#, python-brace-format
msgid "{prog}: invalid number: {text}\n"
msgstr "{prog}：無效數字：{text}\n"

#: src/npcli/args.py:228
#, python-brace-format
msgid "{prog}: port out of range\n"
msgstr "{prog}：連接埠超出範圍\n"

#: src/npcli/args.py:239
#, python-brace-format
msgid "{prog}: lambda must be positive\n"
msgstr "{prog}：lambda 必須為正數\n"

#: src/npcli/args.py:240
#, python-brace-format
msgid "{prog}: duration must be positive\n"
msgstr "{prog}：時長必須為正數\n"

#: src/npcli/args.py:247
#, python-brace-format
msgid "{prog}: unknown profile {name}\n"
msgstr "{prog}: 未知設定檔 {name}\n"

#: src/npcli/args.py:331 src/npcli/args.py:339
#, python-brace-format
msgid "{prog}: unknown option {opt}\n"
msgstr "{prog}：未知選項 {opt}\n"

#: src/npcli/args.py:403
#, python-brace-format
msgid "{prog}: unexpected argument {text}\n"
msgstr "{prog}：多餘的參數 {text}\n"

#: src/npcli/args.py:409
#, python-brace-format
msgid "{prog}: do not combine --daemon with SERVER\n"
msgstr "{prog}：不要同時使用 --daemon 和伺服器位址\n"

#: src/npcli/args.py:411
#, python-brace-format
msgid "{prog}: --stdio-server is exclusive\n"
msgstr "{prog}: --stdio-server 不能與其他模式並用\n"

#: src/npcli/args.py:413
#, python-brace-format
msgid "{prog}: --udp cannot combine with --ssh\n"
msgstr "{prog}: --udp 不能與 --ssh 並用\n"

#: src/npcli/args.py:415
#, python-brace-format
msgid "{prog}: UDP --tls requires --psk\n"
msgstr "{prog}: UDP 的 --tls 需要 --psk\n"

#: src/npcli/args.py:417
#, python-brace-format
msgid "{prog}: --cert and --key must be used together\n"
msgstr "{prog}: --cert 與 --key 必須同時使用\n"

#: src/npcli/args.py:419
#, python-brace-format
msgid "{prog}: choose --install or --remove\n"
msgstr "{prog}: 請選擇 --install 或 --remove\n"

#: src/npcli/args.py:427 src/npcli/args.py:434
#, python-brace-format
msgid "{prog}: invalid server address\n"
msgstr "{prog}：伺服器位址無效\n"

#: src/npcli/main.py:93
#, python-brace-format
msgid "{prog}: wrote {path}"
msgstr "{prog}: 已寫入 {path}"

#: src/npcli/main.py:94
#, python-brace-format
msgid ""
"{prog}: run: systemctl --user daemon-reload && systemctl --user enable --now "
"netpoisson"
msgstr "{prog}: 請執行: systemctl --user daemon-reload && systemctl --user enable --now netpoisson"

#: src/npcli/main.py:102
#, python-brace-format
msgid "{prog}: removed {path}"
msgstr "{prog}: 已移除 {path}"

#: src/npcli/main.py:104
#, python-brace-format
msgid "{prog}: no unit at {path}"
msgstr "{prog}: {path} 沒有單元"

#: src/npcli/main.py:139 src/npcli/main.py:152
#, python-brace-format
msgid "{prog}: {message}\n"
msgstr "{prog}：{message}\n"

#: src/npcli/main.py:154
#, python-brace-format
msgid "{prog}: dashboard {url}"
msgstr "{prog}：儀表板 {url}"

#: src/npcli/main.py:225
#, python-brace-format
msgid "{prog}: --lambda applies to the client; ignoring it"
msgstr "{prog}：--lambda 只對客戶端有效，已忽略"

#: src/npcli/main.py:242 src/npcli/main.py:325
#, python-brace-format
msgid "{prog}: {message}"
msgstr "{prog}：{message}"

#: src/npcli/main.py:249
#, python-brace-format
msgid "{prog}: listening on {proto}://{endpoint}"
msgstr "{prog}：正在聆聽 {proto}://{endpoint}"

#: src/npcli/main.py:291
#, python-brace-format
msgid "{prog}: --host is the listen address; the target is SERVER"
msgstr "{prog}：--host 是聆聽位址；目標是位置參數 SERVER"

#: src/npcli/main.py:330
#, python-brace-format
msgid "{prog}: connected {proto} {endpoint} at {lam} req/s"
msgstr "{prog}：已連線 {proto} {endpoint}，{lam} 請求/秒"

#~ msgid ""
#~ "Offer a Poisson stream of requests to SERVER, or listen for them when\n"
#~ "SERVER is omitted.\n"
#~ msgstr "依卜瓦松過程向伺服器送出請求；若省略伺服器，則改為聆聽。\n"

#~ msgid ""
#~ "  -d, --daemon       listen (also the default when SERVER is omitted)\n"
#~ msgstr "  -d, --daemon       聆聽（省略伺服器時也是預設行為）\n"

#~ msgid "  -H, --host HOST    address to bind (default 0.0.0.0)\n"
#~ msgstr "  -H, --host HOST    繫結位址（預設 0.0.0.0）\n"

#~ msgid "  -p, --port PORT    port to bind or connect to (default 1871)\n"
#~ msgstr "  -p, --port PORT    繫結或連線的連接埠（預設 1871）\n"

#~ msgid "  -u, --udp          use UDP (default is TCP)\n"
#~ msgstr "  -u, --udp          使用 UDP（預設為 TCP）\n"

#~ msgid "  -l, --lambda N     offered requests per second (default 100)\n"
#~ msgstr "  -l, --lambda N     每秒送出的請求數（預設 100）\n"

#~ msgid ""
#~ "  -s, --stats SECS   run for SECS seconds, then print a JSON report\n"
#~ msgstr "  -s, --stats SECS   執行 SECS 秒，然後印出 JSON 報告\n"

#~ msgid "  -w, --web          serve a live dashboard and open a browser\n"
#~ msgstr "  -w, --web          提供即時儀表板並開啟瀏覽器\n"

#~ msgid "      --web-host H   dashboard address (default 127.0.0.1)\n"
#~ msgstr "      --web-host H   儀表板位址（預設 127.0.0.1）\n"

#~ msgid "      --web-port N   dashboard port (default 8711)\n"
#~ msgstr "      --web-port N   儀表板連接埠（預設 8711）\n"

#~ msgid ""
#~ "ECHO responses are the request bytes. STATUS responses carry the server\n"
#~ "timeline and queues. Req/Resp lines scroll right: newest slices on the "
#~ "left.\n"
#~ msgstr ""
#~ "ECHO 的回應就是請求位元組。STATUS 帶回伺服器時間線與佇列。\n"
#~ "Req/Resp 向右捲動：最新的時間片在左邊。\n"

#~ msgid ""
#~ "Req counts local arrivals per slice (newest on the left). The center "
#~ "number has not left this host."
#~ msgstr ""
#~ "Req 是本機每個時間片的到達數（最新在左）。中間的數字還沒離開本機網口。"

#~ msgid ""
#~ "Resp counts server replies per slice. Left of the arrow: requests not yet "
#~ "read. Next: replies not yet sent."
#~ msgstr ""
#~ "Resp 是伺服器每個時間片的回應數。箭頭左邊：還沒被讀取/分析的請求。其後：還"
#~ "沒離開網口的回應。"
