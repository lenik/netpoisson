msgstr "{prog}: --cert ve --key birlikte kullanılmalı\n"

#: src/npcli/args.py:419
#, python-brace-format
msgid "{prog}: choose --install or --remove\n"
msgstr "{prog}: --install veya --remove seçin\n"

#: src/npcli/args.py:427 src/npcli/args.py:434
#, python-brace-format
msgid "{prog}: invalid server address\n"
msgstr "{prog}: geçersiz sunucu adresi\n"

