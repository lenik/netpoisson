msgstr "{prog}: lambda harus positif\n"

#: src/npcli/args.py:240
#, python-brace-format
msgid "{prog}: duration must be positive\n"
msgstr "{prog}: durasi harus positif\n"

#: src/npcli/args.py:247
#, python-brace-format
msgid "{prog}: unknown profile {name}\n"
msgstr "{prog}: profil tidak dikenal {name}\n"

#: src/npcli/args.py:331 src/npcli/args.py:339
#, python-brace-format
msgid "{prog}: unknown option {opt}\n"
msgstr "{prog}: opsi tidak dikenal {opt}\n"

#: src/npcli/args.py:403
#, python-brace-format
msgid "{prog}: unexpected argument {text}\n"
msgstr "{prog}: argumen tak terduga {text}\n"

#: src/npcli/args.py:409
#, python-brace-format
msgid "{prog}: do not combine --daemon with SERVER\n"
msgstr "{prog}: jangan gabungkan --daemon dengan SERVER\n"

#: src/npcli/args.py:411
#, python-brace-format
msgid "{prog}: --stdio-server is exclusive\n"
msgstr "{prog}: --stdio-server bersifat eksklusif\n"

#: src/npcli/args.py:413
#, python-brace-format
msgid "{prog}: --udp cannot combine with --ssh\n"
msgstr "{prog}: --udp tidak dapat digabung dengan --ssh\n"

#: src/npcli/args.py:415
#, python-brace-format
msgid "{prog}: UDP --tls requires --psk\n"
msgstr "{prog}: UDP --tls memerlukan --psk\n"

#: src/npcli/args.py:417
#, python-brace-format
msgid "{prog}: --cert and --key must be used together\n"
msgstr "{prog}: --cert dan --key harus dipakai bersama\n"

#: src/npcli/args.py:419
#, python-brace-format
msgid "{prog}: choose --install or --remove\n"
msgstr "{prog}: pilih --install atau --remove\n"

#: src/npcli/args.py:427 src/npcli/args.py:434
#, python-brace-format
msgid "{prog}: invalid server address\n"
msgstr "{prog}: alamat server tidak valid\n"

#: src/npcli/main.py:93
#, python-brace-format
msgid "{prog}: wrote {path}"
msgstr "{prog}: menulis {path}"

#: src/npcli/main.py:94
#, python-brace-format
msgid ""
"{prog}: run: systemctl --user daemon-reload && systemctl --user enable --now "
"netpoisson"
msgstr "{prog}: jalankan: systemctl --user daemon-reload && systemctl --user enable --now netpoisson"

#: src/npcli/main.py:102
#, python-brace-format
msgid "{prog}: removed {path}"
msgstr "{prog}: menghapus {path}"

#: src/npcli/main.py:104
#, python-brace-format
msgid "{prog}: no unit at {path}"
msgstr "{prog}: tidak ada unit di {path}"

#: src/npcli/main.py:139 src/npcli/main.py:152
#, python-brace-format
msgid "{prog}: {message}\n"
msgstr "{prog}: {message}\n"

#: src/npcli/main.py:154
#, python-brace-format
msgid "{prog}: dashboard {url}"
msgstr "{prog}: dasbor {url}"

#: src/npcli/main.py:225
#, python-brace-format
msgid "{prog}: --lambda applies to the client; ignoring it"
msgstr "{prog}: --lambda untuk klien; diabaikan"

#: src/npcli/main.py:242 src/npcli/main.py:325
#, python-brace-format
msgid "{prog}: {message}"
msgstr "{prog}: {message}"

#: src/npcli/main.py:249
#, python-brace-format
msgid "{prog}: listening on {proto}://{endpoint}"
msgstr "{prog}: mendengarkan {proto}://{endpoint}"

#: src/npcli/main.py:291
#, python-brace-format
msgid "{prog}: --host is the listen address; the target is SERVER"
msgstr "{prog}: --host adalah alamat dengar; targetnya SERVER"

#: src/npcli/main.py:330
#, python-brace-format
msgid "{prog}: connected {proto} {endpoint} at {lam} req/s"
msgstr "{prog}: tersambung {proto} {endpoint} pada {lam} req/d"

#~ msgid ""
#~ "Offer a Poisson stream of requests to SERVER, or listen for them when\n"
#~ "SERVER is omitted.\n"
#~ msgstr ""
#~ "Kirim aliran Poisson permintaan ke SERVER, atau dengarkan jika SERVER "
#~ "dihilangkan.\n"

#~ msgid ""
#~ "  -d, --daemon       listen (also the default when SERVER is omitted)\n"
#~ msgstr ""
#~ "  -d, --daemon       dengarkan (juga bawaan jika SERVER dihilangkan)\n"

#~ msgid "  -H, --host HOST    address to bind (default 0.0.0.0)\n"
#~ msgstr "  -H, --host HOST    alamat bind (bawaan 0.0.0.0)\n"

#~ msgid "  -p, --port PORT    port to bind or connect to (default 1871)\n"
#~ msgstr "  -p, --port PORT    port bind atau sambungan (bawaan 1871)\n"

#~ msgid "  -u, --udp          use UDP (default is TCP)\n"
#~ msgstr "  -u, --udp          gunakan UDP (bawaan TCP)\n"

#~ msgid "  -l, --lambda N     offered requests per second (default 100)\n"
#~ msgstr ""
#~ "  -l, --lambda N     permintaan yang ditawarkan per detik (bawaan 100)\n"

#~ msgid ""
#~ "  -s, --stats SECS   run for SECS seconds, then print a JSON report\n"
#~ msgstr "  -s, --stats SECS   jalankan SECS detik, lalu cetak laporan JSON\n"

#~ msgid "  -w, --web          serve a live dashboard and open a browser\n"
#~ msgstr "  -w, --web          sajikan dasbor langsung dan buka peramban\n"

#~ msgid "      --web-host H   dashboard address (default 127.0.0.1)\n"
#~ msgstr "      --web-host H   alamat dasbor (bawaan 127.0.0.1)\n"

#~ msgid "      --web-port N   dashboard port (default 8711)\n"
#~ msgstr "      --web-port N   port dasbor (bawaan 8711)\n"

#~ msgid ""
#~ "ECHO responses are the request bytes. STATUS responses carry the server\n"
#~ "timeline and queues. Req/Resp lines scroll right: newest slices on the "
#~ "left.\n"
#~ msgstr ""
#~ "Respons ECHO adalah bita permintaan. STATUS membawa linimasa dan "
#~ "antrean.\n"
#~ "Baris Req/Resp bergeser ke kanan: irisan terbaru di kiri.\n"

#~ msgid ""
#~ "Req counts local arrivals per slice (newest on the left). The center "
#~ "number has not left this host."
#~ msgstr ""
#~ "Req menghitung kedatangan lokal per irisan (terbaru di kiri). Angka di "
#~ "tengah belum meninggalkan host ini."

#~ msgid ""
#~ "Resp counts server replies per slice. Left of the arrow: requests not yet "
#~ "read. Next: replies not yet sent."
#~ msgstr ""
#~ "Resp menghitung balasan server per irisan. Kiri panah: permintaan yang "
#~ "belum dibaca. Berikutnya: balasan yang belum terkirim."
