#: src/netpoisson.py:66
msgid "Usage: netpoisson [OPTION]... [SERVER]\n"
msgstr "Utilisation : netpoisson [OPTION]... [SERVEUR]\n"

#: src/netpoisson.py:69
msgid ""
"Offer a Poisson stream of requests to SERVER, or listen for them when\n"
"SERVER is omitted.\n"
msgstr ""
"Envoie un flux de Poisson de requêtes à SERVEUR, ou écoute si SERVEUR est "
"omis.\n"

#: src/netpoisson.py:74
msgid "  -d, --daemon       listen (also the default when SERVER is omitted)\n"
msgstr "  -d, --daemon       écouter (aussi le défaut si SERVEUR est omis)\n"

#: src/netpoisson.py:75
msgid "  -H, --host HOST    address to bind (default 0.0.0.0)\n"
msgstr "  -H, --host HOST    adresse d'écoute (défaut 0.0.0.0)\n"

#: src/netpoisson.py:76
msgid "  -p, --port PORT    port to bind or connect to (default 1871)\n"
msgstr "  -p, --port PORT    port d'écoute ou de connexion (défaut 1871)\n"

#: src/netpoisson.py:77
msgid "  -u, --udp          use UDP (default is TCP)\n"
msgstr "  -u, --udp          utiliser UDP (TCP par défaut)\n"

#: src/netpoisson.py:78
msgid "  -l, --lambda N     offered requests per second (default 100)\n"
msgstr "  -l, --lambda N     requêtes offertes par seconde (défaut 100)\n"

#: src/netpoisson.py:79
msgid "  -s, --stats SECS   run for SECS seconds, then print a JSON report\n"
msgstr ""
"  -s, --stats SECS   tourner SECS secondes, puis afficher un rapport JSON\n"

#: src/netpoisson.py:80
msgid "  -w, --web          serve a live dashboard and open a browser\n"
msgstr ""
"  -w, --web          servir un tableau de bord et ouvrir un navigateur\n"

#: src/netpoisson.py:81
msgid "      --web-host H   dashboard address (default 127.0.0.1)\n"
msgstr "      --web-host H   adresse du tableau de bord (défaut 127.0.0.1)\n"

#: src/netpoisson.py:82
msgid "      --web-port N   dashboard port (default 8711)\n"
msgstr "      --web-port N   port du tableau de bord (défaut 8711)\n"

#: src/netpoisson.py:84
msgid "repeat for more verbose loggings\n"
msgstr "répéter pour des journaux plus détaillés\n"

#: src/netpoisson.py:86
msgid "show less logging messages\n"
msgstr "afficher moins de messages\n"

#: src/netpoisson.py:88
msgid "display this help and exit\n"
msgstr "afficher cette aide et quitter\n"

#: src/netpoisson.py:90
msgid "output version information and exit\n"
msgstr "afficher la version et quitter\n"

#: src/netpoisson.py:94
msgid ""
"ECHO responses are the request bytes. STATUS responses carry the server\n"
"timeline and queues. Req/Resp lines scroll right: newest slices on the "
"left.\n"
msgstr ""
"Les réponses ECHO sont les octets de la requête. STATUS porte la chronologie "
"et les files.\n"
"Req/Resp défilent vers la droite : les tranches récentes sont à gauche.\n"

#: src/netpoisson.py:99
msgid "Report bugs to: <{email}>\n"
msgstr "Signaler les bogues à : <{email}>\n"

#: src/netpoisson.py:104
msgid "Copyright (C) {year} {author}\n"
msgstr "Copyright (C) {year} {author}\n"

#: src/netpoisson.py:105
msgid ""
"License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr ""
"Licence AGPL-3.0-or-later : <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/netpoisson.py:106
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr ""
"Ceci est un logiciel libre : vous pouvez le modifier et le redistribuer.\n"

#: src/netpoisson.py:107
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Ce projet s'oppose à l'exploitation et à l'hégémonie de l'IA.\n"

#: src/netpoisson.py:110
msgid ""
"This project rejects mindless MIT-style licensing and politically naive BSD-"
"style licensing.\n"
msgstr ""
"Ce projet rejette les licences MIT irréfléchies et les licences BSD "
"politiquement naïves.\n"

#: src/netpoisson.py:114
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "Il n'y a AUCUNE GARANTIE, dans les limites permises par la loi.\n"

