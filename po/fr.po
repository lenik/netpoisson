#~ msgstr "  -l, --lambda N     requêtes offertes par seconde (défaut 100)\n"

#~ msgid "  -s, --stats SECS   run for SECS seconds, then print a JSON report\n"
#~ msgstr "  -s, --stats SECS   tourner SECS secondes, puis afficher un rapport JSON\n"

#~ msgid "  -w, --web          serve a live dashboard and open a browser\n"
#~ msgstr "  -w, --web          servir un tableau de bord et ouvrir un navigateur\n"

#~ msgid "      --web-host H   dashboard address (default 127.0.0.1)\n"
#~ msgstr "      --web-host H   adresse du tableau de bord (défaut 127.0.0.1)\n"

#~ msgid "      --web-port N   dashboard port (default 8711)\n"
#~ msgstr "      --web-port N   port du tableau de bord (défaut 8711)\n"

#~ msgid ""
#~ "ECHO responses are the request bytes. STATUS responses carry the server\n"
#~ "timeline and queues. Req/Resp lines scroll right: newest slices on the left.\n"
#~ msgstr ""
#~ "Les réponses ECHO sont les octets de la requête. STATUS porte la chronologie et les files.\n"
#~ "Req/Resp défilent vers la droite : les tranches récentes sont à gauche.\n"

#~ msgid "Req counts local arrivals per slice (newest on the left). The center number has not left this host."
#~ msgstr "Req compte les arrivées locales par tranche (les plus récentes à gauche). Le nombre central n'a pas encore quitté cet hôte."

#~ msgid "Resp counts server replies per slice. Left of the arrow: requests not yet read. Next: replies not yet sent."
#~ msgstr "Resp compte les réponses du serveur par tranche. À gauche de la flèche : requêtes pas encore lues. Ensuite : réponses pas encore envoyées."
