msgstr "{prog} : {message}"

#: src/netpoisson.py:337
#, python-brace-format
msgid "{prog}: listening on {proto}://{endpoint}"
msgstr "{prog} : écoute sur {proto}://{endpoint}"

#: src/netpoisson.py:357
#, python-brace-format
msgid "{prog}: --host is the listen address; the target is SERVER"
msgstr "{prog} : --host est l'adresse d'écoute ; la cible est SERVEUR"

#: src/netpoisson.py:371
#, python-brace-format
msgid "{prog}: connected {proto} {endpoint} at {lam} req/s"
msgstr "{prog} : connecté à {proto} {endpoint} à {lam} req/s"

#: src/netpoisson.py:382
msgid ""
"Req counts local arrivals per slice (newest on the left). The center number "
"has not left this host."
msgstr ""
"Req compte les arrivées locales par tranche (les plus récentes à gauche). Le "
"nombre central n'a pas encore quitté cet hôte."

#: src/netpoisson.py:389
msgid ""
"Resp counts server replies per slice. Left of the arrow: requests not yet "
"read. Next: replies not yet sent."
msgstr ""
"Resp compte les réponses du serveur par tranche. À gauche de la flèche : "
"requêtes pas encore lues. Ensuite : réponses pas encore envoyées."
