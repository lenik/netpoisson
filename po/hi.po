#: src/netpoisson.py:66
msgid "Usage: netpoisson [OPTION]... [SERVER]\n"
msgstr "उपयोग: netpoisson [विकल्प]... [सर्वर]\n"

#: src/netpoisson.py:69
msgid ""
"Offer a Poisson stream of requests to SERVER, or listen for them when\n"
"SERVER is omitted.\n"
msgstr "SERVER को पॉइसन प्रवाह में अनुरोध भेजें, या SERVER न होने पर सुनें।\n"

#: src/netpoisson.py:74
msgid "  -d, --daemon       listen (also the default when SERVER is omitted)\n"
msgstr "  -d, --daemon       सुनें (SERVER छोड़ने पर भी यही डिफ़ॉल्ट है)\n"

#: src/netpoisson.py:75
msgid "  -H, --host HOST    address to bind (default 0.0.0.0)\n"
msgstr "  -H, --host HOST    बाइंड पता (डिफ़ॉल्ट 0.0.0.0)\n"

#: src/netpoisson.py:76
msgid "  -p, --port PORT    port to bind or connect to (default 1871)\n"
msgstr "  -p, --port PORT    बाइंड या कनेक्ट पोर्ट (डिफ़ॉल्ट 1871)\n"

#: src/netpoisson.py:77
msgid "  -u, --udp          use UDP (default is TCP)\n"
msgstr "  -u, --udp          UDP उपयोग करें (डिफ़ॉल्ट TCP)\n"

#: src/netpoisson.py:78
msgid "  -l, --lambda N     offered requests per second (default 100)\n"
msgstr "  -l, --lambda N     प्रति सेकंड प्रस्तावित अनुरोध (डिफ़ॉल्ट 100)\n"

#: src/netpoisson.py:79
msgid "  -s, --stats SECS   run for SECS seconds, then print a JSON report\n"
msgstr "  -s, --stats SECS   SECS सेकंड चलाकर JSON रिपोर्ट छापें\n"

#: src/netpoisson.py:80
msgid "  -w, --web          serve a live dashboard and open a browser\n"
msgstr "  -w, --web          लाइव डैशबोर्ड परोसें और ब्राउज़र खोलें\n"

#: src/netpoisson.py:81
msgid "      --web-host H   dashboard address (default 127.0.0.1)\n"
msgstr "      --web-host H   डैशबोर्ड पता (डिफ़ॉल्ट 127.0.0.1)\n"

#: src/netpoisson.py:82
msgid "      --web-port N   dashboard port (default 8711)\n"
msgstr "      --web-port N   डैशबोर्ड पोर्ट (डिफ़ॉल्ट 8711)\n"

#: src/netpoisson.py:84
msgid "repeat for more verbose loggings\n"
msgstr "अधिक विस्तृत लॉग के लिए दोहराएँ\n"

#: src/netpoisson.py:86
msgid "show less logging messages\n"
msgstr "कम लॉग संदेश दिखाएँ\n"

#: src/netpoisson.py:88
msgid "display this help and exit\n"
msgstr "यह सहायता दिखाकर निकलें\n"

#: src/netpoisson.py:90
msgid "output version information and exit\n"
msgstr "संस्करण जानकारी दिखाकर निकलें\n"

#: src/netpoisson.py:94
msgid ""
"ECHO responses are the request bytes. STATUS responses carry the server\n"
"timeline and queues. Req/Resp lines scroll right: newest slices on the left.\n"
msgstr ""
"ECHO उत्तर अनुरोध के बाइट हैं। STATUS समयरेखा और कतारें लाता है।\n"
"Req/Resp दाएँ खिसकते हैं: नवीनतम स्लाइस बाएँ।\n"

#: src/netpoisson.py:99
#, python-brace-format
msgid "Report bugs to: <{email}>\n"
msgstr "त्रुटियाँ भेजें: <{email}>\n"

#: src/netpoisson.py:104
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "कॉपीराइट (C) {year} {author}\n"

#: src/netpoisson.py:105
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "लाइसेंस AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/netpoisson.py:106
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "यह मुक्त सॉफ़्टवेयर है: आप इसे बदल और बाँट सकते हैं।\n"

#: src/netpoisson.py:107
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "यह परियोजना एआई शोषण और एआई वर्चस्व का विरोध करती है।\n"

#: src/netpoisson.py:110
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "यह परियोजना बिना सोचे MIT-शैली और राजनीतिक रूप से भोले BSD-शैली लाइसेंस को अस्वीकार करती है।\n"

#: src/netpoisson.py:114
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "कानून द्वारा अनुमत सीमा तक कोई वारंटी नहीं है।\n"

#: src/netpoisson.py:133
#, python-brace-format
msgid "{prog}: missing argument for {opt}\n"
msgstr "{prog}: {opt} के लिए तर्क नहीं है\n"

#: src/netpoisson.py:141 src/netpoisson.py:151
#, python-brace-format
msgid "{prog}: invalid number: {text}\n"
msgstr "{prog}: अमान्य संख्या: {text}\n"

#: src/netpoisson.py:143 src/netpoisson.py:228
#, python-brace-format
msgid "{prog}: port out of range\n"
msgstr "{prog}: पोर्ट सीमा से बाहर\n"

#: src/netpoisson.py:154
#, python-brace-format
msgid "{prog}: lambda must be positive\n"
msgstr "{prog}: lambda धनात्मक होना चाहिए\n"

#: src/netpoisson.py:155
#, python-brace-format
msgid "{prog}: duration must be positive\n"
msgstr "{prog}: अवधि धनात्मक होनी चाहिए\n"

#: src/netpoisson.py:199 src/netpoisson.py:207
#, python-brace-format
msgid "{prog}: unknown option {opt}\n"
msgstr "{prog}: अज्ञात विकल्प {opt}\n"

#: src/netpoisson.py:230
#, python-brace-format
msgid "{prog}: unexpected argument {text}\n"
msgstr "{prog}: अप्रत्याशित तर्क {text}\n"

#: src/netpoisson.py:234
#, python-brace-format
msgid "{prog}: do not combine --daemon with SERVER\n"
msgstr "{prog}: --daemon को SERVER के साथ न जोड़ें\n"

#: src/netpoisson.py:242 src/netpoisson.py:249
#, python-brace-format
msgid "{prog}: invalid server address\n"
msgstr "{prog}: सर्वर पता अमान्य है\n"

#: src/netpoisson.py:292
#, python-brace-format
msgid "{prog}: {message}\n"
msgstr "{prog}: {message}\n"

#: src/netpoisson.py:294
#, python-brace-format
msgid "{prog}: dashboard {url}"
msgstr "{prog}: डैशबोर्ड {url}"

#: src/netpoisson.py:324
#, python-brace-format
msgid "{prog}: --lambda applies to the client; ignoring it"
msgstr "{prog}: --lambda क्लाइंट के लिए है; अनदेखा किया गया"

#: src/netpoisson.py:333 src/netpoisson.py:367
#, python-brace-format
msgid "{prog}: {message}"
msgstr "{prog}: {message}"

#: src/netpoisson.py:337
#, python-brace-format
msgid "{prog}: listening on {proto}://{endpoint}"
msgstr "{prog}: {proto}://{endpoint} पर सुन रहा है"

#: src/netpoisson.py:357
#, python-brace-format
msgid "{prog}: --host is the listen address; the target is SERVER"
msgstr "{prog}: --host सुनने का पता है; लक्ष्य SERVER है"

#: src/netpoisson.py:371
#, python-brace-format
msgid "{prog}: connected {proto} {endpoint} at {lam} req/s"
msgstr "{prog}: {proto} {endpoint} से जुड़ा, {lam} अनुरोध/से"

#: src/netpoisson.py:382
msgid "Req counts local arrivals per slice (newest on the left). The center number has not left this host."
msgstr "Req इस होस्ट पर हर समय-खंड की आगमन संख्या है (नया बाएँ)। बीच की संख्या अभी नेट से नहीं निकली।"

#: src/netpoisson.py:389
msgid "Resp counts server replies per slice. Left of the arrow: requests not yet read. Next: replies not yet sent."
msgstr "Resp सर्वर के हर समय-खंड के उत्तर हैं। तीर के बाएँ: अभी न पढ़े अनुरोध। उसके बाद: अभी न भेजे उत्तर।"
