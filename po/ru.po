#, python-brace-format
msgid "{prog}: do not combine --daemon with SERVER\n"
msgstr "{prog}: не совмещайте --daemon с адресом сервера\n"

#: src/npcli/args.py:411
#, python-brace-format
msgid "{prog}: --stdio-server is exclusive\n"
msgstr "{prog}: --stdio-server нельзя сочетать с другим\n"

#: src/npcli/args.py:413
#, python-brace-format
msgid "{prog}: --udp cannot combine with --ssh\n"
msgstr "{prog}: --udp нельзя сочетать с --ssh\n"

#: src/npcli/args.py:415
#, python-brace-format
msgid "{prog}: UDP --tls requires --psk\n"
msgstr "{prog}: для UDP --tls нужен --psk\n"

#: src/npcli/args.py:417
#, python-brace-format
msgid "{prog}: --cert and --key must be used together\n"
msgstr "{prog}: --cert и --key нужно указывать вместе\n"

#: src/npcli/args.py:419
#, python-brace-format
msgid "{prog}: choose --install or --remove\n"
msgstr "{prog}: укажите --install или --remove\n"

#: src/npcli/args.py:427 src/npcli/args.py:434
#, python-brace-format
msgid "{prog}: invalid server address\n"
msgstr "{prog}: неверный адрес сервера\n"

