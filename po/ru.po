#, python-brace-format
msgid "{prog}: invalid number: {text}\n"
msgstr "{prog}: неверное число: {text}\n"

#: src/npcli/args.py:228
#, python-brace-format
msgid "{prog}: port out of range\n"
msgstr "{prog}: порт вне диапазона\n"

#: src/npcli/args.py:239
#, python-brace-format
msgid "{prog}: lambda must be positive\n"
msgstr "{prog}: lambda должно быть положительным\n"

#: src/npcli/args.py:240
#, python-brace-format
msgid "{prog}: duration must be positive\n"
msgstr "{prog}: длительность должна быть положительной\n"

#: src/npcli/args.py:247
#, python-brace-format
msgid "{prog}: unknown profile {name}\n"
msgstr "{prog}: неизвестный профиль {name}\n"

#: src/npcli/args.py:331 src/npcli/args.py:339
#, python-brace-format
msgid "{prog}: unknown option {opt}\n"
msgstr "{prog}: неизвестный параметр {opt}\n"

