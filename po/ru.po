"{prog}: run: systemctl --user daemon-reload && systemctl --user enable --now "
"netpoisson"
msgstr "{prog}: выполните: systemctl --user daemon-reload && systemctl --user enable --now netpoisson"

#: src/npcli/main.py:102
#, python-brace-format
msgid "{prog}: removed {path}"
msgstr "{prog}: удалено {path}"

#: src/npcli/main.py:104
#, python-brace-format
msgid "{prog}: no unit at {path}"
msgstr "{prog}: нет юнита в {path}"

#: src/npcli/main.py:139 src/npcli/main.py:152
#, python-brace-format
msgid "{prog}: {message}\n"
msgstr "{prog}: {message}\n"

#: src/npcli/main.py:154
#, python-brace-format
msgid "{prog}: dashboard {url}"
msgstr "{prog}: панель {url}"

#: src/npcli/main.py:225
#, python-brace-format
msgid "{prog}: --lambda applies to the client; ignoring it"
msgstr "{prog}: --lambda относится к клиенту; игнорируется"

#: src/npcli/main.py:242 src/npcli/main.py:325
#, python-brace-format
msgid "{prog}: {message}"
msgstr "{prog}: {message}"

#: src/npcli/main.py:249
#, python-brace-format
msgid "{prog}: listening on {proto}://{endpoint}"
msgstr "{prog}: слушаю {proto}://{endpoint}"

#: src/npcli/main.py:291
#, python-brace-format
msgid "{prog}: --host is the listen address; the target is SERVER"
msgstr "{prog}: --host — адрес прослушивания; цель задаётся аргументом сервера"

#: src/npcli/main.py:330
#, python-brace-format
msgid "{prog}: connected {proto} {endpoint} at {lam} req/s"
msgstr "{prog}: подключено {proto} {endpoint}, {lam} запр./с"

#~ msgid ""
#~ "Offer a Poisson stream of requests to SERVER, or listen for them when\n"
#~ "SERVER is omitted.\n"
#~ msgstr ""
#~ "Шлёт запросы серверу по процессу Пуассона; если СЕРВЕР не указан — "
#~ "слушает.\n"

#~ msgid ""
#~ "  -d, --daemon       listen (also the default when SERVER is omitted)\n"
#~ msgstr ""
#~ "  -d, --daemon       слушать (также по умолчанию, если сервер не указан)\n"

#~ msgid "  -H, --host HOST    address to bind (default 0.0.0.0)\n"
#~ msgstr "  -H, --host HOST    адрес привязки (по умолчанию 0.0.0.0)\n"

#~ msgid "  -p, --port PORT    port to bind or connect to (default 1871)\n"
#~ msgstr ""
#~ "  -p, --port PORT    порт привязки или подключения (по умолчанию 1871)\n"

#~ msgid "  -u, --udp          use UDP (default is TCP)\n"
#~ msgstr "  -u, --udp          использовать UDP (по умолчанию TCP)\n"

#~ msgid "  -l, --lambda N     offered requests per second (default 100)\n"
#~ msgstr ""
#~ "  -l, --lambda N     предлагаемые запросы в секунду (по умолчанию 100)\n"

#~ msgid ""
#~ "  -s, --stats SECS   run for SECS seconds, then print a JSON report\n"
#~ msgstr ""
#~ "  -s, --stats SECS   работать SECS секунд, затем вывести отчёт JSON\n"

#~ msgid "  -w, --web          serve a live dashboard and open a browser\n"
#~ msgstr "  -w, --web          отдать живую панель и открыть браузер\n"

#~ msgid "      --web-host H   dashboard address (default 127.0.0.1)\n"
#~ msgstr "      --web-host H   адрес панели (по умолчанию 127.0.0.1)\n"

#~ msgid "      --web-port N   dashboard port (default 8711)\n"
#~ msgstr "      --web-port N   порт панели (по умолчанию 8711)\n"

#~ msgid ""
#~ "ECHO responses are the request bytes. STATUS responses carry the server\n"
#~ "timeline and queues. Req/Resp lines scroll right: newest slices on the "
#~ "left.\n"
#~ msgstr ""
#~ "Ответ ECHO — те же байты запроса. STATUS несёт шкалу времени и очереди.\n"
#~ "Строки Req/Resp бегут вправо: новые интервалы слева.\n"

#~ msgid ""
#~ "Req counts local arrivals per slice (newest on the left). The center "
#~ "number has not left this host."
#~ msgstr ""
#~ "Req — локальные прибытия по интервалам (новые слева). Число в центре ещё "
#~ "не покинуло этот узел."

#~ msgid ""
#~ "Resp counts server replies per slice. Left of the arrow: requests not yet "
#~ "read. Next: replies not yet sent."
#~ msgstr ""
#~ "Resp — ответы сервера по интервалам. Слева от стрелки: запросы ещё не "
#~ "прочитаны. Дальше: ответы ещё не отправлены."
