# SPDX-License-Identifier: AGPL-3.0-or-later
# stub — align with debian/control and Meson install
pkgname=netpoisson
pkgver=0.0.0
pkgrel=1
pkgdesc="Poisson request generator and echo server"
arch=('any')
url="https://github.com/lenik/netpoisson"
license=('AGPL-3.0-or-later')
depends=('python')
makedepends=('meson' 'ninja' 'asciidoctor')
source=()
sha256sums=()

pkgver() {
  cd "$startdir/../.."
  zfr version 2>/dev/null | sed 's/^v//' || head -n1 VERSION
}

build() {
  cd "$startdir/../.."
  meson setup build-arch --prefix=/usr --buildtype=plain
  meson compile -C build-arch
}

package() {
  cd "$startdir/../.."
  DESTDIR="$pkgdir" meson install -C build-arch
}
